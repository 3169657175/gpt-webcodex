{
  "name": "web-mcp-assistant",
  "version": "0.9.1",
  "description": "一键部署与管理 Coding Tools MCP、OpenAI Tunnel 和 ChatGPT 接入的 Windows 桌面助手",
  "author": "3169657175",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "icon:build": "node scripts/generate-icon.js",
    "start": "npm run ui:build && electron .",
    "test": "node scripts/run-python-tests.js && node --test tests/*.test.js && node scripts/check-source-root-clean.js",
    "soak": "node scripts/soak-stable-execution.js --minutes 30",
    "soak:quick": "node scripts/soak-stable-execution.js --cycles 3",
    "audit:prod": "npm audit --omit=dev",
    "dist": "npm run icon:build && npm run release:verify && node scripts/run-electron-builder-release.js",
    "dist:dir": "npm run icon:build && electron-builder --dir",
    "ui:build": "vite build --config renderer-ui/vite.config.ts",
    "ui:check": "tsc -p renderer-ui/tsconfig.json --noEmit",
    "test:quick": "npm run ui:check && python scripts/check-schema-contract.py && node --test tests/assistant-state-v090.test.js tests/auto-memory-v042.test.js tests/task-notification.test.js tests/v090-architecture.test.js",
    "release:verify": "npm run ui:check && npm run ui:build && npm test && npm run soak:quick && node scripts/check-release-readiness.js",
    "release:git-ready": "node scripts/check-release-git-ready.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.gptwebcodex.assistant",
    "productName": "网页 MCP 助手",
    "artifactName": "web-mcp-assistant-setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "renderer/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*",
          "!coding-tools-mcp/**/__pycache__/**",
          "!coding-tools-mcp/**/*.pyc"
        ]
      }
    ],
    "win": {
      "icon": "electron/app-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "网页 MCP 助手",
      "installerIcon": "electron/app-icon.ico",
      "uninstallerIcon": "electron/app-icon.ico",
      "installerHeaderIcon": "electron/app-icon.ico",
      "runAfterFinish": true
    }
  }
}
